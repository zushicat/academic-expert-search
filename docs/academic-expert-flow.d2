direction: down

title: "Academic Expert Search Active Flow"

client: "HTTP Client"

api_layer: {
  label: "API Layer"

  app: "src/app.py\nFastAPI app"
  auth_gate: "src/auth.py\nbearer_auth_dependency"
  exceptions: "Shared exception handlers\n404 | validation | general"

  root_router: {
    label: "root_route"
    root_get: "GET /"
    root_post: "POST /"
  }

  experts_router: {
    label: "experts_routes"
    route_search: "GET /expert/search"
    route_recommender: "GET /expert/recommender"
  }
}

shared_support: {
  label: "Shared Support"

  settings: "src/settings.py\nBaseSettings config"
  filehandler: "helpers/filehandler.py\nread_text_file | read_json_file | write_*"
  toon_helper: "helpers/toon.py\nencode_toon | decode_toon"
  query_prompt: "data/ExpertQuery/prompts/query_expansion.txt"
  analysis_prompt: "data/ExpertAnalysis/prompts/author_works_summary.txt"
  search_models: "models/expert_search_models.py\nExpertSearch_* models"
  recommender_models: "models/expert_recommender_models.py\nExpertRecommender_* models"
}

external_systems: {
  label: "External Systems"

  openalex_works: "OpenAlex Works API"
  openalex_authors: "OpenAlex Authors API"
  litellm_gateway: "litellm"
  llm_provider: "Configured LLM provider\nvia model/base_url/api_key"
}

search_flow: {
  label: "Search Flow"

  expert_search_class: "classes/ExpertSearch.py\nExpertSearch"
  search_entry: "search_experts(query, use_fulltext_search, create_queries)"
  search_works: "_search_works"
  query_expander: "classes/ExpertQuery.py\ncreate_queries"
  ref_author_ids: "_get_reference_author_ids"
  request_reference_authors: "_request_reference_authors"
  reference_topics: "_get_reference_author_topics"
  most_shared_topics: "_get_most_shared_topics"
  topics_combinations: "_get_most_shared_topics_combinations"
  authors_by_topics: "_get_authors_by_topics"
  aggregate_authors: "_aggregate_authors"
  assign_search_works: "_assign_search_works_authors"
  sort_author_batches: "_sort_batch_authors_by_topics_count"
  search_response: "ExpertSearch_Response\n{topics, works, institutions, authors, meta}"
}

recommender_flow: {
  label: "Recommender Flow"

  expert_recommender_class: "classes/ExpertRecommender.py\nExpertRecommender"
  recommend_entry: "recommend_experts(search_result, create_expert_summaries)"
  top_topic_share: "_get_top_topic_share"
  filter_search_result: "_filter_search_result"
  get_author_works: "_get_works"
  process_author_works: "_processworks_from_authors"

  graph_stage: {
    label: "ExpertGraph"
    graph_build: "build_graph"
    graph_scores: "get_best_experts"
    graph_connections: "get_connected_authors"
  }

  update_stage: {
    label: "ExpertUpdate"
    update_scores: "update_author_scores"
    update_connections: "update_author_connections"
    update_results: "update_search_result_objects"
  }

  analysis_stage: {
    label: "ExpertAnalysis"
    analyze_author: "analyze_author"
    title_batches: "_create_title_batches"
    toon_batches: "_create_toon_batches"
    create_prompts: "_create_prompts"
    llm_batch_requests: "_request_llm_batches"
  }

  recommender_payload: "Final response payload\n{topics, works, authors, meta}"
}

client -> app: "requests service"
app -> auth_gate: "global dependency"
app -> exceptions: "registers"
app -> root_router: "include_router"
app -> experts_router: "include_router"

auth_gate -> root_router: "bypass auth when path == /"
auth_gate -> experts_router: "enforce bearer token when USE_API_KEY=true"

root_router -> root_get: "GET /"
root_router -> root_post: "POST /"

experts_router -> route_search: "mounted endpoint"
experts_router -> route_recommender: "mounted endpoint"

route_search -> expert_search_class: "instantiate"
expert_search_class -> search_entry: "run"

search_entry -> search_works: "step 1"
search_works -> query_expander: "if create_queries=true"
query_expander -> query_prompt: "load prompt template"
query_expander -> filehandler: "read_text_file"
query_expander -> litellm_gateway: "acompletion"
litellm_gateway -> llm_provider: "send prompt"

search_works -> openalex_works: "request works search"
search_works -> ref_author_ids: "dedupe works + collect author ids"
ref_author_ids -> request_reference_authors: "reference author ids"
request_reference_authors -> openalex_authors: "batch author lookup"
request_reference_authors -> reference_topics: "author topic lists"
reference_topics -> most_shared_topics: "count shared topics"
most_shared_topics -> topics_combinations: "build topics_filter"
topics_combinations -> authors_by_topics: "filter authors by topics"
authors_by_topics -> openalex_authors: "request topic-matched authors"

request_reference_authors -> aggregate_authors: "aggregate reference authors"
authors_by_topics -> aggregate_authors: "aggregate topic authors"
search_works -> assign_search_works: "works map"
aggregate_authors -> assign_search_works: "attach works_search"
assign_search_works -> sort_author_batches: "sort by relevant_topics_share"
sort_author_batches -> search_response: "create typed response"

search_entry -> search_models: "build Pydantic models"
settings -> auth_gate: "USE_API_KEY / API_KEY"
settings -> query_expander: "LLM query-expansion settings"
settings -> search_works: "OPENALEX_API_KEY"
settings -> request_reference_authors: "OPENALEX_API_KEY"
settings -> authors_by_topics: "OPENALEX_API_KEY"

route_recommender -> expert_search_class: "instantiate searcher"
route_recommender -> expert_recommender_class: "instantiate recommender"
route_recommender -> search_entry: "search first"
search_response -> recommend_entry: "pass ExpertSearch_Response"

expert_recommender_class -> recommend_entry: "run"
recommend_entry -> top_topic_share: "step 1"
top_topic_share -> filter_search_result: "author share threshold"
filter_search_result -> get_author_works: "filtered authors/topics"
get_author_works -> openalex_works: "request recent author works"
get_author_works -> process_author_works: "works_from_authors"

process_author_works -> graph_build: "enriched works + authors"
graph_build -> graph_scores: "score experts"
graph_build -> graph_connections: "find coauthor/institution groups"
graph_scores -> update_scores: "raw score dict"
graph_connections -> update_scores: "connectivity metadata"
graph_connections -> update_connections: "membership groups"
update_scores -> update_results: "relevant author ids"
update_connections -> update_results: "connection lists"
update_results -> recommender_models: "transform to recommender author models"

recommend_entry -> analysis_stage: "if create_expert_summaries=true"
analysis_stage -> analyze_author: "optional summary branch"
analyze_author -> title_batches: "prepare per-author titles"
title_batches -> toon_batches: "group author/year titles"
toon_batches -> toon_helper: "encode_toon"
toon_batches -> create_prompts: "compose prompt inputs"
create_prompts -> analysis_prompt: "load prompt template"
create_prompts -> filehandler: "read_text_file"
create_prompts -> llm_batch_requests: "batch prompts"
llm_batch_requests -> litellm_gateway: "acompletion"
analyze_author -> update_results: "attach summaries to authors"

update_results -> recommender_payload: "filtered works + institutions + authors"
recommend_entry -> recommender_payload: "serialize response_data"

search_response.style.fill: "#E8F4FF"
recommender_payload.style.fill: "#EAF7E8"
openalex_works.style.fill: "#FFF4DD"
openalex_authors.style.fill: "#FFF4DD"
litellm_gateway.style.fill: "#F8E8FF"
llm_provider.style.fill: "#F8E8FF"
