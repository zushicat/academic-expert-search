API_KEY=sk-1234
USE_API_KEY=false

OPENALEX_API_KEY=

# Model Request Parameters: Analyzer
LLM_ANALYZER_MAX_CONCURRENCY=10
LLM_ANALYZER_BATCH_SIZE=10
LLM_ANALYZER_TIMEOUT=30

# low | medium | high
LLM_ANALYZER_REASONING_EFFORT="low"
LLM_QUERY_EXPANSION_REASONING_EFFORT="medium"

# Model Request Parameters: Query Expansion
LLM_QUERY_EXPANSION_MAX_CONCURRENCY=10
LLM_QUERY_EXPANSION_BATCH_SIZE=5
LLM_QUERY_EXPANSION_TIMEOUT=30


# ***
# GROQ
# Rate limits (oss 120/20):
# - free:   RPM 30 | RPD 1K     | TPM 8K
# - dev:    RPM 1K | RPD 500K   | TPM 250K
#
# https://console.groq.com/docs/rate-limits
# ***
LLM_ANALYZER_MODEL="groq/openai/gpt-oss-120b"
LLM_ANALYZER_BASE_URL="https://api.groq.com/openai/v1"
LLM_ANALYZER_API_KEY=

LLM_QUERY_EXPANSION_MODEL="groq/openai/gpt-oss-120b"
LLM_QUERY_EXPANSION_BASE_URL="https://api.groq.com/openai/v1"
